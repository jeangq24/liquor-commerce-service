DATABASE_URL=postgresql://postgres:postgres@localhost:5432/licoresyaaa
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Trusted BFF credentials. Generate independent random values of at least 32 characters.
COMMERCE_INTERNAL_API_TOKEN=

# Inventory service (INTERNAL_API_TOKEN must match the Inventory deployment).
INVENTORY_API_URL=http://localhost:3000
INVENTORY_SERVICE_TOKEN=
INVENTORY_LOCATION_ID=
INVENTORY_TIMEOUT_MS=5000

# Catalog service (token must match CATALOG_SERVICE_API_TOKEN in Catalog).
CATALOG_API_URL=http://localhost:3002
CATALOG_SERVICE_TOKEN=
CATALOG_TIMEOUT_MS=5000

# Optional: disposable PostgreSQL database for real concurrency tests.
# The tests apply the Drizzle migrations automatically.
# POSTGRES_TEST_DATABASE_URL=